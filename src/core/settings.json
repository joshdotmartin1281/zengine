            { "action": "Jump",     "binding_type": "Keyboard", "glfw_code": 32  },
            { "action": "Crouch",   "binding_type": "Keyboard", "glfw_code": 341 },
            { "action": "Sprint",   "binding_type": "Keyboard", "glfw_code": 340 },
            { "action": "Pause",    "binding_type": "Keyboard", "glfw_code": 256 },
